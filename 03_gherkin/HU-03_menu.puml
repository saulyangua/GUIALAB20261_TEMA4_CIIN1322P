@startuml HU-03_menu
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam activity {
  BackgroundColor #F2F4F8
  BorderColor #1F4E79
  FontColor #1F4E79
  DiamondBackgroundColor #D9E1F2
  DiamondBorderColor #1F4E79
  DiamondFontColor #1F4E79
  ArrowColor #1F4E79
}

title Diagrama de Actividad - HU-03: Visualización del Menú del Día (UniDelivery)

start
:Estudiante autenticado accede a la sección "Menú del Día";
:El sistema consulta la publicación del menú para la fecha actual;

if (¿Menú publicado por la cafetería?) then (Sí)
  #E2EFDA:Cargar catálogo de platos del día (platos de fondo, bebidas, postres);
  #E2EFDA:Mostrar detalle por ítem: nombre, precio, descripción, stock e imagen;
  #E2EFDA:Habilitar opciones de selección y agregado al carrito;
  stop
else (No)
  #FCE4D6:Ocultar listado de platos;
  #FCE4D6:Mostrar mensaje informativo:\n"El menú de hoy aún no ha sido publicado. Por favor, vuelve a consultar a partir de las 10:30 AM";
  :Habilitar botón "Recargar Menú";
  stop
endif

@enduml
